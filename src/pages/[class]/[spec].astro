---
// One page per registered spec, and the registry is the whole list of them.
//
// Class before spec, because the spec key alone does not identify a spec in MoP: `restoration` is a
// Druid and a Shaman, and `/restoration` has no way to say which. `registry.test.ts` holds the pair
// unique rather than the key, which is the invariant this route rests on.
//
// The spec reaches the island as its **key** rather than as its definition, and that is the island
// boundary rather than a preference. Astro serialises an island's props into the document, and a
// `SpecDefinition` is mostly functions — `analyse`, `identify`, `score` — none of which survives a
// round trip through JSON. `App` resolves the key back through the same registry this page read it
// from, so the two cannot name different specs.
import '~/styles/global.css';

import App from '~/components/App';
import Base from '~/layouts/Base.astro';
import { SPECS } from '~/lib/spec';

export function getStaticPaths() {
	return SPECS.map((spec) => ({ params: { class: spec.classSlug, spec: spec.key } }));
}

const spec = SPECS.find((candidate) => candidate.key === Astro.params.spec);
if (spec === undefined) {
	// Unreachable: the paths above are built from this same list. Thrown rather than defaulted, because
	// the default would be a spec the address does not name, and a report is scored against whichever
	// spec it was told.
	throw new Error(`No spec is registered as "${Astro.params.spec}", yet a route was built for it.`);
}
---

<Base
	title={`${spec.displayName} analyzer (alpha)`}
	description={`Read a Mists of Pandaria ${spec.displayName} pull from its own event stream: economy discipline, buff snapshots, lost casts and a timestamped miss ledger. Runs entirely in your browser.`}
	specColor={spec.colors.primary}
>
	{/* client:load, not client:visible: the island is the entire page, so there is nothing to defer. */}
	<App client:load specKey={spec.key} />
</Base>

{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    // TypeScript 7 removed `baseUrl`. Without it, `paths` resolves relative to this file, so the
    // mapping has to be written as an explicit relative path.
    "paths": { "~/*": ["./src/*"] },
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [".astro/types.d.ts", "**/*"],
  // `src/generated` is graphql-codegen's output, rewritten by `npm run codegen` on every build and
  // never hand-edited — the same reason `.oxfmtrc.json` already skips it. Excluded as a *root* only:
  // every file that imports it is still checked against these types, so the API contract is enforced
  // exactly as before. What stops is `astro check` reporting style hints about generated code nobody
  // can act on — the `import * as Types` the import-types preset emits whether or not the operations
  // end up referencing a schema type.
  "exclude": ["dist", "src/generated"]
}

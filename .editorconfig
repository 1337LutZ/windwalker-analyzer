# Source is tab-indented (see astro.config.mjs and src/**). The exceptions below are not style
# preferences: YAML forbids tab indentation outright, and npm rewrites package.json with two spaces
# on every install, so pinning those to spaces keeps diffs clean.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
# Two trailing spaces is a hard line break in Markdown — stripping them changes the rendered text.
trim_trailing_whitespace = false
